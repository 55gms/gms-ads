# --- Server ---
NODE_ENV=development
# Port the Express app listens on. In dev, Vite owns :3000 and proxies to the API on API_PORT.
PORT=3000
API_PORT=3001
# Public origin of the ad server, no trailing slash. Used for absolute image URLs and the OIDC redirect URI.
PUBLIC_BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the app (Coolify's Traefik = 1). 0 when reached directly.
TRUST_PROXY=0
# Set to false only for local http development in browsers that refuse Secure cookies on localhost (Safari).
COOKIE_SECURE=true
LOG_LEVEL=info

# --- Database (DATABASE_URL wins; otherwise the standard PG* variables are used) ---
DATABASE_URL=postgres://gms_ads:gms_ads@localhost:5432/gms_ads
# PGHOST=localhost
# PGPORT=5432
# PGUSER=gms_ads
# PGPASSWORD=gms_ads
# PGDATABASE=gms_ads
# Set to "require" when the database needs TLS without a verifiable certificate.
PGSSLMODE=disable

# --- Sessions ---
# 32+ random bytes. Signs access tokens and encrypts the short-lived OIDC attempt cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Authometry (written to .env.local by provisioning; never commit real values) ---
AUTHOMETRY_APPLICATION_ID=
AUTHOMETRY_ISSUER=https://authometry.ch3n.cc
AUTHOMETRY_CLIENT_ID=
AUTHOMETRY_CLIENT_SECRET=
# true = sign-out also ends the Authometry session through the discovered end-session endpoint.
AUTHOMETRY_PROVIDER_LOGOUT=false
# Comma-separated emails that are approved as admin on first sign-in (verified emails only).
ADMIN_EMAILS=

# --- Media ---
# Persistent directory for uploaded creatives. Mount a volume here in Coolify.
MEDIA_DIR=/data/media
# Comma-separated hosts allowed for external creative URLs. Empty = any public https host.
EXTERNAL_IMAGE_HOSTS=cdn.jsdelivr.net

# --- Embed snippet (from embed/dist/manifest.json after `npm run release:embed`) ---
EMBED_REPO=55gms/gms-ads
EMBED_VERSION=1.0.0
EMBED_SRI=

# --- Edge module (set on the 55GMS game server, not on the ad server) ---
# ADS_SERVER_URL=https://ads.example.com
# ADS_API_KEY=gms_live_...
# ADS_EDGE_SECRET=   # shared by every edge instance; signs serve IDs
# ADS_SPOOL_DIR=/var/lib/55gms-ads
